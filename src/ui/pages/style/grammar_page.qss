/* ═══════════════════════════════════════════════════════════════
   Grammar Page Stylesheet
   ═══════════════════════════════════════════════════════════════ */

/* ── Tab Bar ─────────────────────────────────────────────────── */

QWidget#GrammarTabBar {
    background-color: #ffffff;
}

#GrammarTabBar QPushButton {
    background: transparent;
    border: none;
    border-bottom: 3px solid transparent;
    padding: 10px 20px;
    font-size: 13px;
    font-weight: 500;
    color: #666666;
    border-radius: 0;
}

#GrammarTabBar QPushButton:hover {
    color: #007acc;
    background-color: #f0f7ff;
}

#GrammarTabBar QPushButton:checked {
    color: #007acc;
    font-weight: bold;
    border-bottom: 3px solid #007acc;
}

/* ── Header & Labels ─────────────────────────────────────────── */

QLabel#GrammarTitle {
    font-size: 16px;
    font-weight: bold;
    color: #111111;
}

QWidget#GrammarTopBar {
    background-color: #ffffff;
    border-bottom: 1px solid #e0e0e0;
    min-height: 40px;
}

QLabel#GrammarHint {
    color: #777777;
    font-size: 11px;
}

QLabel#GrammarCount {
    color: #666666;
    font-size: 12px;
    padding-left: 4px;
}

QLabel#GrammarLabelHint {
    color: #555555;
    font-size: 12px;
    font-weight: bold;
}

/* ── Buttons ─────────────────────────────────────────────────── */

QPushButton#GrammarBtnAdd {
    background-color: #007acc;
    color: #ffffff;
    font-weight: bold;
    padding: 6px 14px;
    border-radius: 4px;
    border: none;
}

QPushButton#GrammarBtnAdd:hover {
    background-color: #005999;
}

QPushButton#GrammarBtnDelete {
    color: #c0392b;
}

QPushButton#GrammarBtnSave {
    background-color: #007acc;
    color: #ffffff;
    font-weight: bold;
    padding: 8px 18px;
    border-radius: 4px;
    border: none;
}

QPushButton#GrammarBtnSave:hover {
    background-color: #005999;
}

QPushButton#GrammarCatBtn {
    background-color: #f0f0f0;
    color: #333333;
    border: 1px solid #cccccc;
    border-radius: 4px;
    padding: 4px 10px;
    font-size: 11px;
}

QPushButton#GrammarCatBtn:hover {
    background-color: #e0e0e0;
}

/* ── Scroll Areas ────────────────────────────────────────────── */

QScrollArea#GrammarScroll {
    border: none;
    background: transparent;
}

/* ── Category Cards ──────────────────────────────────────────── */

QFrame.GrammarCategoryCard {
    background-color: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 6px;
    padding: 4px;
}

QFrame.GrammarCategoryCard:hover {
    border-color: #b0d4f1;
    background-color: #fafcff;
}

QLabel#GrammarCatBadge {
    background-color: #007acc;
    color: #ffffff;
    font-size: 12px;
    font-weight: bold;
    min-width: 28px;
    max-width: 28px;
    min-height: 20px;
    max-height: 20px;
    border-radius: 10px;
    text-align: center;
}

QLabel#GrammarCatName {
    font-size: 13px;
    font-weight: bold;
    color: #111111;
}

QLabel#GrammarCatDesc {
    font-size: 11px;
    color: #777777;
    margin-left: 6px;
}

/* ── Rules Table ─────────────────────────────────────────────── */

QTableWidget#GrammarRulesTable {
    background-color: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 6px;
    alternate-background-color: #f7f9fb;
    gridline-color: #e8eaed;
    selection-background-color: #e3f0ff;
    selection-color: #111111;
}

QTableWidget#GrammarRulesTable::item {
    padding: 6px 8px;
    color: #111111;
}

QTableWidget#GrammarRulesTable QHeaderView::section {
    background-color: #f0f2f5;
    border: none;
    border-bottom: 1px solid #dcdcdc;
    padding: 6px 8px;
    font-weight: bold;
    color: #333333;
}

/* ── Paradigm Cards ──────────────────────────────────────────── */

QFrame.GrammarParadigmCard {
    background-color: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    padding: 4px;
}

QFrame.GrammarParadigmCard:hover {
    border-color: #b0d4f1;
}

QLabel#GrammarParadigmTitle {
    font-size: 14px;
    font-weight: bold;
    color: #111111;
}

QLabel#GrammarParadigmDesc {
    font-size: 11px;
    color: #777777;
    margin-left: 8px;
}

/* ── Paradigm Grid Table (inside cards & dialog) ─────────────── */

QTableWidget#GrammarParadigmTable {
    background-color: #ffffff;
    border: 1px solid #dcdcdc;
    border-radius: 4px;
    alternate-background-color: #f9fafb;
    gridline-color: #e8eaed;
    selection-background-color: #e3f0ff;
    selection-color: #111111;
}

QTableWidget#GrammarParadigmTable::item {
    padding: 4px 6px;
    color: #111111;
}

QTableWidget#GrammarParadigmTable QHeaderView::section {
    background-color: #eef2f7;
    border: none;
    border-bottom: 1px solid #dcdcdc;
    border-right: 1px solid #e8eaed;
    padding: 5px 8px;
    font-weight: bold;
    color: #333333;
    font-size: 12px;
}

/* ── Templates Table ─────────────────────────────────────────── */

QTableWidget#GrammarTemplatesTable {
    background-color: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 6px;
    alternate-background-color: #f7f9fb;
    gridline-color: #e8eaed;
    selection-background-color: #e3f0ff;
    selection-color: #111111;
}

QTableWidget#GrammarTemplatesTable::item {
    padding: 6px 8px;
    color: #111111;
}

QTableWidget#GrammarTemplatesTable QHeaderView::section {
    background-color: #f0f2f5;
    border: none;
    border-bottom: 1px solid #dcdcdc;
    padding: 6px 8px;
    font-weight: bold;
    color: #333333;
}

/* ── Dialogs (inherited from page scope) ─────────────────────── */

QDialog {
    background-color: #ffffff;
}

QDialog QLabel {
    color: #222222;
}

QDialog QLineEdit, QDialog QPlainTextEdit, QDialog QComboBox {
    background-color: #ffffff;
    border: 1px solid #cccccc;
    border-radius: 4px;
    padding: 6px 8px;
    color: #111111;
}

QDialog QLineEdit:focus, QDialog QPlainTextEdit:focus, QDialog QComboBox:focus {
    border: 1px solid #007acc;
}

QDialog QSpinBox {
    background-color: #ffffff;
    border: 1px solid #cccccc;
    border-radius: 4px;
    padding: 4px 8px;
    color: #111111;
}

QDialog QSpinBox:focus {
    border: 1px solid #007acc;
}
